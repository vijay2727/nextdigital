# DigitalNext Backend Environment Configuration (PostgreSQL on Render)

# Server Port (Render sets this automatically to 10000 in production)
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# PostgreSQL Database Connection String
# In Render: Automatically populated when linked to Render Managed PostgreSQL
# Local development format:
DATABASE_URL=postgres://digitalnext_user:password123@localhost:5432/digitalnext

# Remote Render PostgreSQL format (from Render Database dashboard):
# DATABASE_URL=postgres://digitalnext_user:your_password@dpg-xxxx-a.oregon-postgres.render.com/digitalnext
